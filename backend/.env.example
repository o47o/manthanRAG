# Manthan RAG — standalone retrieval service configuration.
# Copy to backend/.env (or pass as environment variables; env vars win).

# ── Database (Postgres + pgvector) ─────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DB_SCHEMA=manthan_rag
DB_SSLMODE=require
DB_POOL_MAX=5

# ── File storage ───────────────────────────────────────────
# Supabase Storage. Leave SUPABASE_URL / SUPABASE_SERVICE_KEY empty to store
# files on local disk instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=manthan-rag-docs

# ── LLM (customer-supplied, OpenAI-compatible) ─────────────
# Base URL only — the service appends /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Embeddings / reranker (downloaded once into the models volume) ──
EMBEDDING_MODEL=intfloat/e5-large-v2
RERANKER_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_HUB_OFFLINE=1

# ── Queue ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Knowledge graph (optional) ─────────────────────────────
NEO4J_ENABLED=false
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ── Tracing (optional; nothing leaves the install unless set) ──
OTEL_EXPORTER_OTLP_ENDPOINT=
